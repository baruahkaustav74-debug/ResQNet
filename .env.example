# GEMINI_API_KEY: Required for Gemini AI Rescue Assistant API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign authentication session cookies/tokens.
JWT_SECRET="replace-with-a-long-random-secret"

# DB_PATH: SQLite database file path (defaults to ./data/disasterguard.db).
DB_PATH="./data/disasterguard.db"

# Optional: Bootstrap the initial admin account automatically on first boot.
# Leave blank to initialize the first admin securely via the in-app First-Run Setup screen.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript & Routes API key.
VITE_GOOGLE_MAPS_API_KEY=""

